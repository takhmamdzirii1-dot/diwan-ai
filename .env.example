# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AI Provider Keys
OPENROUTER_API_KEY="your-openrouter-api-key"

# Runware image generation (server-side only; never prefix with NEXT_PUBLIC_)
RUNWARE_API_KEY="your-runware-api-key"

# Manual BaridiMob / CCP transfer destinations shown only to authenticated payers.
BARIDIMOB_RIP=
CCP_ACCOUNT_HOLDER=
CCP_ACCOUNT_NUMBER=
CCP_ACCOUNT_KEY=
CCP_ACCOUNT_ADDRESS=

# Comma-separated Supabase Auth user UUIDs allowed to access internal owner tools.
# A server-managed app_metadata.role of "owner" is also accepted.
VANTRA_OWNER_USER_IDS="owner-user-uuid"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"


# Provider BYOP token encryption (AES-256-GCM). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_TOKEN_ENCRYPTION_KEY="generate-a-64-char-hex-key"

# Pollinations OAuth App Key (pk_... publishable key with redirect URI registered)
# Register: create app key at gen.pollinations.ai -> Account -> Keys (type: publishable, redirect URI: https://ai-alpha-delta-six.vercel.app/api/provider-connections/pollinations)
POLLINATIONS_APP_KEY=
